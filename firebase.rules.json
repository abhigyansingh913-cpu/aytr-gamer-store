{
  "rules": {
    "admins": {
      ".read": true,
      ".write": false
    },
    "mods": {
      "$id": {
        ".read": true,
        ".write": "auth.token.admin === true",
        "downloads": {
          ".write": "newData.val() === (data.val() || 0) + 1"
        }
      }
    },
    "categories": {
      ".read": true,
      ".write": "auth.token.admin === true"
    },
    "ads": {
      ".read": true,
      ".write": "auth.token.admin === true"
    }
  }
}
