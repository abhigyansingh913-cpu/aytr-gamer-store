rules_version = '2';

service firebase.storage {
  function isAdmin() {
    return request.auth != null && request.auth.token.admin == true;
  }

  match /b/{bucket}/o {
    // Public read for all store files (thumbnails, screenshots, downloads).
    match /{allPaths=**} {
      allow read: if true;
    }

    // Only signed-in admins (custom claim `admin: true`) may upload,
    // replace or delete files. Deletes are granted separately because
    // `request.resource` (size) does not exist on delete requests.
    match /thumbnails/{file} {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /screenshots/{file} {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /files/{file} {
      allow write: if isAdmin() && request.resource.size < 200 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /banners/{file} {
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    // Legacy/other paths fall back to authenticated-admin-only writes.
    match /uploads/{allPaths=**} {
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
